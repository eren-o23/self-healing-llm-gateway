# Copy to .env and fill in. Any provider whose key is missing is dropped from
# every ladder at startup with a warning - the gateway still boots and serves.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Local OSS backend. Always available, so it is the floor of every ladder.
# Running outside docker, the default (http://localhost:11434) is correct.
OLLAMA_API_BASE=http://localhost:11434

REDIS_URL=redis://localhost:6379/0

# Guards every /admin route, including the chaos fault-injection API. Unset means
# the admin router returns 503 rather than running unauthenticated.
ADMIN_SECRET=change-me
